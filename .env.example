# Base URL for the portfolio analysis backend API.
#
# Development (pnpm dev):
#   Leave this unset or set to http://localhost:8080.
#   The Vite dev server proxy will forward all /api/* requests to this target,
#   so the browser never makes a cross-origin request (no CORS issues).
#
# Production (pnpm build):
#   Set this to your deployed backend URL (e.g. https://api.example.com).
#   The value is inlined at build time by Vite.
#
# Never commit a .env file with real secrets — only commit this .env.example.
VITE_API_BASE_URL=http://localhost:8080
